        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "received / day (UTC)",
            "drawStyle": "bars",
            "barAlignment": -1,
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "decbytes"
        },
        "overrides": []
      },

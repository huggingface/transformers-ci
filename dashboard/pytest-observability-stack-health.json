   "id": 203,
   "type": "stat",
   "title": "Spans accepted \u2212 filtered \u2212 sent (24h)",
   "description": "Spans the collector accepted but neither dropped on purpose nor shipped to Tempo, over 24h: receiver_accepted \u2212 processor_filter_spans_filtered \u2212 exporter_sent. The filter term is the repository-privacy deny rule (internal huggingface/* clones), whose drops are by design \u2014 without it this stat reads red every time a private clone exports. A large positive delta is real buffering/loss: cross-check exporter_send_failed_spans, exporter_queue_size and tempo_discarded_spans_total.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 10000
       },
       {
        "color": "red",
        "value": 100000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name"
   },
   "pluginVersion": "12.0.0",
   "targets": [
    {
     "editorMode": "code",
     "expr": "sum(increase(otelcol_receiver_accepted_spans[24h])) - (sum(increase(otelcol_processor_filter_spans_filtered[24h])) or vector(0)) - sum(increase(otelcol_exporter_sent_spans[24h]))",
     "instant": true,
     "range": false,
     "legendFormat": "Spans accepted \u2212 filtered \u2212 sent (24h)",
     "refId": "A"
    }
   ],

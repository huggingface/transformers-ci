      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, max by (pr) ((last_over_time(pytest_run_end_time_seconds{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"}[$__range]) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",pr!=\"main\"}[$__range]))) * 1000))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Activity"
        },
        {
          "editorMode": "code",
          "expr": "count by (pr) (max by (pr, run_id) (last_over_time(pytest_run_start_time_seconds{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"}[$__range]) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",pr!=\"main\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Runs"
        },
        {
          "editorMode": "code",
          "expr": "sum by (pr) (max by (pr, run_id) (last_over_time(pytest_run_failed_tests{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"}[$__range]) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",pr!=\"main\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Failures"
        },
        {
          "editorMode": "code",
          "expr": "100 * sum by (pr) (max by (pr, run_id) (last_over_time(pytest_run_failed_tests{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"}[$__range]) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",pr!=\"main\"}[$__range])))) / sum by (pr) (max by (pr, run_id) (last_over_time(pytest_run_total_tests{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"}[$__range]) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",pr!=\"main\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Rate"
        },
        {
          "editorMode": "code",
          "expr": "floor((time() - max by (pr) (last_over_time(pytest_pr_created_at_seconds{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"}[$__range]))) / 86400)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Age"
        }
      ],
      "title": "Last 10 PRs",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "pr": 0,
              "Value #Age": 1,

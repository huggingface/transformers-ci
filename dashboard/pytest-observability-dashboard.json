      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, max by (pr) ((last_over_time(pytest_run_end_time_seconds{pr=~\".*\",pr!=\"main\"}[$__range]) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{test_job=~\".*\",pr=~\".*\",pr!=\"main\"}[$__range]))) * 1000))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Activity"
        },
        {
          "editorMode": "code",
          "expr": "max by (pr, title) (last_over_time(pytest_pr_info{pr=~\".*\",pr!=\"main\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Title"
        },
        {
          "editorMode": "code",
          "expr": "count by (pr) (max by (pr, run_id) (last_over_time(pytest_run_start_time_seconds{pr=~\".*\",pr!=\"main\"}[$__range]) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{test_job=~\".*\",pr=~\".*\",pr!=\"main\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Runs"
        },
        {
          "editorMode": "code",
          "expr": "sum by (pr) (max by (pr, run_id) ((sum by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_failed_tests{pr=~\".*\",pr!=\"main\"}[$__range])) or sum by (service_name, provider, pr, run_id) (last_over_time(pytest_run_failed_tests{pr=~\".*\",pr!=\"main\"}[$__range]))) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{test_job=~\".*\",pr=~\".*\",pr!=\"main\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Failures"
        },
        {
          "editorMode": "code",
          "expr": "100 * sum by (pr) (max by (pr, run_id) ((sum by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_failed_tests{pr=~\".*\",pr!=\"main\"}[$__range])) or sum by (service_name, provider, pr, run_id) (last_over_time(pytest_run_failed_tests{pr=~\".*\",pr!=\"main\"}[$__range]))) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{test_job=~\".*\",pr=~\".*\",pr!=\"main\"}[$__range])))) / sum by (pr) (max by (pr, run_id) ((sum by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_total_tests{pr=~\".*\",pr!=\"main\"}[$__range])) or sum by (service_name, provider, pr, run_id) (last_over_time(pytest_run_total_tests{pr=~\".*\",pr!=\"main\"}[$__range]))) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (last_over_time(pytest_run_job_member_info{test_job=~\".*\",pr=~\".*\",pr!=\"main\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Rate"
        },
        {
          "editorMode": "code",
          "expr": "floor((time() - max by (pr) (last_over_time(pytest_pr_created_at_seconds{pr=~\".*\",pr!=\"main\"}[$__range]))) / 86400)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Age"
        }
      ],
      "title": "Last 10 PRs",

              "Value #Runs": 3,
              "Value #Failures": 4,
              "Value #Rate": 5
            },
            "renameByName": {
              "pr": "PR",
              "Value #Age": "Age",
              "Value #Activity": "Last Activity",
              "Value #Runs": "Runs",
              "Value #Failures": "Failures",
              "Value #Rate": "Failure Rate"
            }
          }
        }
      ],
      "type": "table"

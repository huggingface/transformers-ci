      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, max by (pr) ((max without (instance) (last_over_time(pytest_run_end_time_seconds{pr=~\"[0-9]+\"}[$__range])) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_member_info{test_job=~\".*\",pr=~\"[0-9]+\"}[$__range])))) * 1000))",

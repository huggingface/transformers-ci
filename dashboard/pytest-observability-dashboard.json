      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 0},
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Last Activity"}]
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, max by (pr) ((pytest_run_end_time_seconds{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"} * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (pytest_run_suite_member_info{service_name=~\"$service\",test_suite=~\"$suite\",pr=~\"$pr\",pr!=\"main\"})) * 1000))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Activity"
        },
        {
          "editorMode": "code",
          "expr": "count by (pr) (max by (pr, run_id) (pytest_run_start_time_seconds{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"} * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (pytest_run_suite_member_info{service_name=~\"$service\",test_suite=~\"$suite\",pr=~\"$pr\",pr!=\"main\"})))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Runs"
        },
        {
          "editorMode": "code",
          "expr": "sum by (pr) (max by (pr, run_id) (pytest_run_failed_tests{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"} * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (pytest_run_suite_member_info{service_name=~\"$service\",test_suite=~\"$suite\",pr=~\"$pr\",pr!=\"main\"})))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Failures"
        },
        {
          "editorMode": "code",
          "expr": "100 * sum by (pr) (max by (pr, run_id) (pytest_run_failed_tests{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"} * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (pytest_run_suite_member_info{service_name=~\"$service\",test_suite=~\"$suite\",pr=~\"$pr\",pr!=\"main\"}))) / sum by (pr) (max by (pr, run_id) (pytest_run_total_tests{service_name=~\"$service\",pr=~\"$pr\",pr!=\"main\"} * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (pytest_run_suite_member_info{service_name=~\"$service\",test_suite=~\"$suite\",pr=~\"$pr\",pr!=\"main\"})))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Rate"
        }
      ],
      "title": "Last 10 PRs",
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "pr": 0,
              "Value #Activity": 1,
              "Value #Runs": 2,
              "Value #Failures": 3,
              "Value #Rate": 4
            },
            "renameByName": {
              "pr": "PR",
              "Value #Activity": "Last Activity",
              "Value #Runs": "Runs",
              "Value #Failures": "Failures",
              "Value #Rate": "Failure Rate"
            }
          }
        }

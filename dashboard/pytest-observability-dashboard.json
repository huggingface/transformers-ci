          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Activity"
        },
        {
          "editorMode": "code",
          "expr": "max by (pr, title) (topk(1, max without (instance) (last_over_time(pytest_pr_info{pr=~\"[0-9]+\",title!=\"\"}[$__range]))) by (pr))",

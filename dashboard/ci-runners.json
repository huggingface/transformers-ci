      "description": "Every runner type (the scale set a job runs on) and, when known, the hardware a job on it gets. Source \"measured\" comes from the runner itself; \"job log\" is written by hand from that pool's logs.",
      "targets": [
        {
          "refId": "HW",
          "expr": "max by (runner_type, source, cpu_model, vcpus, memory_gib, gpu_vendor, gpu_model, gpu_count, gpu_memory_gib) (last_over_time(ci_runner_hardware_info[30d]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "TYPES",
          "expr": "group by (runner_type) (last_over_time(ci_github_job_runner_info[30d]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"

              "memory_gib": 6,
              "cpu_model": 7,
              "Value #RUN": 8,
              "Value #J24": 9,
              "Value #LAST": 10,
              "source": 11
            },
            "renameByName": {
              "runner_type": "Runner type",
              "gpu_vendor": "GPU vendor",
              "gpu_model": "GPU",
              "gpu_count": "GPUs",
              "gpu_memory_gib": "GPU memory (GiB)",
              "vcpus": "vCPUs",
              "memory_gib": "Memory (GiB)",
              "cpu_model": "CPU",
              "Value #RUN": "Running now",
              "Value #J24": "Jobs (24h)",
              "Value #LAST": "Last job started",
              "source": "Source"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Runner type"
              }
            ]
          }
        }

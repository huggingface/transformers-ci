  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Runners",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Each runner type (GitHub's runner group, the scale set a job lands on) and the hardware a job on it gets. **measured** rows come from the runner itself on every traced job: the CPUs and memory are the job's container share, and the GPUs are the ones it can see. **job log** rows are written by hand from that pool's own logs, for pools no traced job runs on; their CPU is the host's.\n\nFiltered to run `${run_id}`, job `${job}` when opened from a Hardware link.\n\n<iframe title=\"PR search loader\" style=\"display:none\" srcdoc=\"<script>var d=parent.document;if(!d.getElementById('tci-pr-search')){var f=d.createElement('iframe');f.id='tci-pr-search';f.title='Find a PR';f.src='/pr-search';f.style.cssText='position:fixed;top:4px;left:50%;transform:translateX(-50%);width:0;height:0;border:0;z-index:1060;background:transparent;color-scheme:normal';d.body.appendChild(f);}</script>\"></iframe>"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Runner types",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "description": "One row per runner type. Hardware from ci_runner_hardware_info; use from ci-github-status (followed workflows only).",
      "targets": [
        {
          "refId": "HW",
          "expr": "(max by (runner_type, source, cpu_model, vcpus, memory_gib, gpu_vendor, gpu_model, gpu_count, gpu_memory_gib) (last_over_time(ci_runner_hardware_info{runner_type=~\"$runner_type\"}[30d]))) and on (runner_type) ((group by (runner_type) (ci_github_job_runner_info{run_id=~\"$run_id\"} and on (repository, run_id, job_id) ci_github_job_info{test_job=~\"$job\"})) or on (runner_type) (group by (runner_type) (max by (runner_type, source, cpu_model, vcpus, memory_gib, gpu_vendor, gpu_model, gpu_count, gpu_memory_gib) (last_over_time(ci_runner_hardware_info{runner_type=~\"$runner_type\"}[30d]))) and on () (label_replace(label_replace(vector(1), \"v\", \"$run_id$job\", \"\", \"\"), \"u\", \"yes\", \"v\", \"\\\\.\\\\*\\\\.\\\\*\") and on (u) label_replace(vector(1), \"u\", \"yes\", \"\", \"\"))))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "RUN",
          "expr": "count by (runner_type) (ci_github_job_runner_info{runner_type=~\"$runner_type\",run_id=~\"$run_id\"} and on (repository, run_id, job_id) (ci_github_job_status == 2) and on (repository, run_id, job_id) ci_github_job_info{test_job=~\"$job\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "J24",
          "expr": "count by (runner_type) (last_over_time(ci_github_job_runner_info{runner_type=~\"$runner_type\",run_id=~\"$run_id\"}[24h]) and on (repository, run_id, job_id) last_over_time(ci_github_job_info{test_job=~\"$job\"}[24h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "refId": "LAST",
          "expr": "max by (runner_type) (last_over_time(ci_github_job_started_timestamp_seconds[24h]) * on (repository, run_id, job_id) group_left (runner_type) last_over_time(ci_github_job_runner_info{runner_type=~\"$runner_type\",run_id=~\"$run_id\"}[24h]) and on (repository, run_id, job_id) last_over_time(ci_github_job_info{test_job=~\"$job\"}[24h])) * 1000",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,

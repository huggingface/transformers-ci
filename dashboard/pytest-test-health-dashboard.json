                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "test_nodeid"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last Failure"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Streak"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.width",
                "value": 74
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Last Failed"
          }
        ]
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, (topk by (test_nodeid, test_job) (1, last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range]))) * on (test_nodeid, test_job) group_left() (count by (test_nodeid, test_job) (last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range])) > 1))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Sticky Failures (CPU)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "service_name": true,
              "test_class": true,
              "test_module": true
            },
            "indexByName": {
              "test_job": 0,
              "test_function": 1,
              "exception_type": 2,
              "trace_id": 3,
              "Value": 4
            },
            "renameByName": {
              "Value": "Streak",
              "exception_type": "Error",
              "test_function": "Function",
              "test_job": "Job",
              "trace_id": "Last Failure"
            }
          }
        }
      ],
      "type": "table",
      "description": "Tests that keep failing on main: ranked by how many DISTINCT RUNS each one failed in over the selected time range ('Streak'). A test runs in exactly one shard per run, so its distinct failure traces are its distinct failing runs. Single failures are excluded (streak > 1), so an empty panel means nothing is repeatedly broken. Scope is the time range, NOT the last N runs or commits: pytest_test_last_failure_info carries no run_id/commit_sha, so a failure cannot be attributed to a run or a commit \u2014 and 'is it still failing in the newest run' is likewise not expressible (a run of run_models_gpu is ~19 per-model traces). The linked failure is one representative occurrence, not necessarily the most recent."
    },

            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Error"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View test failure",
                    "url": "/d/pytest-test/pytest-test?var-trace_id=${__data.fields[\"Last Failure\"]}&var-test_nodeid=${__data.fields[\"test_nodeid\"]}&var-test_job=${__data.fields[\"Job\"]}&var-pr=main&var-exception_type=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "test_nodeid"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last Failure"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {

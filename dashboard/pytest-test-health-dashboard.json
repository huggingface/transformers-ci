                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Fails"
          }
        ]
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk by (test_nodeid, test_job) (1, ((last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range])) * on (run_id) group_left() (max by (run_id) (last_over_time(pytest_run_start_time_seconds{pr=\"main\"}[$__range])))) and on (test_nodeid, test_job) (topk(25, (count by (test_nodeid, test_job) (max by (test_nodeid, test_job, run_id) (last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range]))) > 1) + (max by (test_nodeid, test_job) ((max by (test_nodeid, test_job, run_id) (last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range]))) * on (run_id) group_left() (max by (run_id) (last_over_time(pytest_run_start_time_seconds{pr=\"main\"}[$__range]))))) / 1000000000000))) * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "LastFail"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(count by (test_nodeid, test_job) (max by (test_nodeid, test_job, run_id) (last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range]))) > 1) and on (test_nodeid, test_job) (topk(25, (count by (test_nodeid, test_job) (max by (test_nodeid, test_job, run_id) (last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range]))) > 1) + (max by (test_nodeid, test_job) ((max by (test_nodeid, test_job, run_id) (last_over_time(pytest_test_last_failure_info{pr=\"main\", test_job!~\".*gpu.*|tests_fsdp_ci|tests_tensor_parallel_ci\"}[$__range]))) * on (run_id) group_left() (max by (run_id) (last_over_time(pytest_run_start_time_seconds{pr=\"main\"}[$__range]))))) / 1000000000000))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Fails"
        }
      ],
      "title": "Sticky Failures (CPU)",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "service_name": true,
              "test_class": true,
              "test_module": true,
              "run_id": true
            },
            "indexByName": {
              "test_job": 0,
              "test_function": 1,
              "exception_type": 2,
              "Value #Fails": 3,
              "Value #LastFail": 4,
              "trace_id": 5
            },
            "renameByName": {
              "test_job": "Job",
              "test_function": "Function",
              "exception_type": "Error",
              "trace_id": "Last Failure",
              "Value #Fails": "Fails",
              "Value #LastFail": "Last Failed"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Fails",
                "desc": true
              },
              {
                "field": "Last Failed",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 25
          }
        }
      ],
      "type": "table",
      "description": "Tests that failed in MORE THAN ONE run of a CPU job on main. 'Fails' = how many distinct runs of that job the test failed in within the dashboard time range, so the range IS the window -- widen it to catch slower flakes, narrow it to see only what is breaking now. Counts distinct run_id values, NOT traces: one run_models_gpu run emits ~19 per-model traces, and a test that failed twice within one run (retry, or two shards) counts that run once. Single failures are excluded. 'Last Failed' is the start of the most recent failing run -- read it together with Fails: high Fails + a recent Last Failed is an active breakage, high Fails + an old Last Failed is a chronic flake that has gone quiet, or history already fixed inside the range. Rows are ranked on Fails with the most recent failure breaking ties. There is deliberately NO failure-rate column: it would need the number of runs in which each test actually RAN, and that is not measurable here -- pytest_test_run_count is retired, and per-job run counts are not a usable substitute because runs are not homogeneous (tests_torch: 35% of runs executed under half its median suite; run_models_gpu mixes daily/nightly full runs of ~160k tests with push runs of ~10k). Dividing by those would understate the rate by ~1.5x and more."
    },

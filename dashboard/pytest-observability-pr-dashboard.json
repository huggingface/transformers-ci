      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, (pytest_test_failure_count{service_name=~\"$service\",pr=~\"$pr\"} > 0) * on(test_nodeid, test_suite, service_name, provider, pr) group_left(trace_id, exception_type) (topk by (test_nodeid, test_suite, service_name, provider, pr) (1, last_over_time(pytest_test_last_failure_info{service_name=~\"$service\",pr=~\"$pr\"}[30s]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Top Failing Tests",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "service_name": true,
              "stacktrace": true,
              "test_class": true,
              "test_module": true,
              "test_nodeid": true
            },
            "indexByName": {
              "test_suite": 0,
              "test_function": 1,
              "exception_type": 2,
              "trace_id": 3,
              "Value": 4
            },
            "renameByName": {
              "Value": "Failures",
              "exception_type": "Error",
              "test_function": "Function",
              "test_suite": "Suite",
              "trace_id": "Last Failure"
            }
          }
        }
      ],
      "type": "table"
    }

        {
          "editorMode": "code",
          "expr": "max by (run_id, pr, commit_message, commit_sha) (max without (instance) (last_over_time(pytest_run_info{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d])) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_member_info{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d]))))",
          "format": "table",
          "instant": true,

      "id": 8,
      "options": {
        "content": "### Last Failure: `${last_failure_exception:raw}`\n\n**Suite:** [${last_failure_suite:raw}](/d/pytest-observability-by-suite?var-suite=${last_failure_suite:raw}) | **Test:** `${last_failure_function:raw}` | [View Run](/d/pytest-observability-by-run?var-run_id=${last_failure_run_id:raw})\n\n```python\n${last_failure_stacktrace:raw}\n```",
        "mode": "markdown"
      },
      "pluginVersion": "12.0.0",
      "repeat": "last_failure_trace_id",
      "repeatDirection": "v",
      "title": "Last Error",
      "type": "text"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Started"},
            "properties": [{"id": "unit", "value": "dateTimeAsLocal"}]
          },
          {
            "matcher": {"id": "byName", "options": "Failure Rate"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {
                "id": "custom.cellOptions",
                "value": {"mode": "gradient", "type": "color-background"}
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "orange", "value": 1},
                    {"color": "red", "value": 10}
                  ]
                }
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Run ID"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View this run",
                    "url": "/d/pytest-observability-by-run?var-run_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Duration"},
            "properties": [{"id": "unit", "value": "s"}]
          }
        ]
      },

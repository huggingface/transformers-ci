                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Suite"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View suite details",
                    "url": "/d/pytest-observability-by-suite?var-suite=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Error"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View traceback",
                    "url": "/d/pytest-traceback?var-trace_id=${__data.fields[\"Last Failure\"]}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 36},
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Failures"}]

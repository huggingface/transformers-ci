      "targets": [
        {
          "editorMode": "code",
          "expr": "pytest_run_start_time_seconds{service_name=~\"$service\",pr=~\"$pr\"} * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Runs",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {"mode": "columns", "valueLabel": ""}
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {"destinationType": "number", "targetField": "suite_count"},
              {"destinationType": "number", "targetField": "total_tests"},
              {"destinationType": "number", "targetField": "failed_tests"},
              {"destinationType": "number", "targetField": "total_duration_seconds"},
              {"destinationType": "number", "targetField": "failure_rate_percent"}
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "service_name": true,
              "trace_count": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Started",
              "suite_count": "Suite Count",
              "suites": "Suites",
              "total_tests": "Total",
              "failed_tests": "Failures",
              "total_duration_seconds": "Duration",
              "failure_rate_percent": "Failure Rate",
              "run_id": "Run ID"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},

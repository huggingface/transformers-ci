        {
          "editorMode": "code",
          "expr": "max by (run_id, pr) (max without (instance) (last_over_time(pytest_run_duration_seconds{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d])) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_member_info{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Duration"
        },
        {
          "editorMode": "code",
          "expr": "floor((100 * (1 - max by (run_id, pr) ((sum by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_failed_tests{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d]))) or sum by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_failed_tests{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d])))) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_member_info{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d])))) / max by (run_id, pr) ((sum by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_total_tests{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d]))) or sum by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_total_tests{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d])))) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_member_info{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d])))))) * 100) / 100",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Result"
        },
        {
          "datasource": null,
          "editorMode": "code",
          "expr": "max by (run_id, pr) ((sum by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_failed_tests{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d]))) or sum by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_failed_tests{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d])))) * on (service_name, provider, pr, run_id) group_left() max by (service_name, provider, pr, run_id) (max without (instance) (last_over_time(pytest_run_job_member_info{ci_event!=\"pr-comment\",pr=~\"$pr\",run_id!~\"$latest_run_id\"}[90d]))))",

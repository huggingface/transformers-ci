          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_passed_tests{ci_event=\"daily\",run_id=~\"$latest_run_id\"}[90d])))"

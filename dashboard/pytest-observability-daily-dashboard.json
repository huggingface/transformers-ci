        {
          "refId": "Started",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_member_info{ci_event=\"daily\",run_id=~\"$latest_run_id\"}[90d])) * on (run_id) group_left() max by (run_id)(max without (instance) (last_over_time(pytest_run_start_time_seconds{ci_event=\"daily\",run_id=~\"$latest_run_id\"}[90d])))) * 1000"
        },

      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "avg by (hardware) (sum by (run_id, hardware) (max by (run_id, test_job, hardware) (max_over_time(pytest_run_job_failed_tests{ci_event=\"daily\", pr=\"main\", hardware=~\"gpu|single-gpu|multi-gpu\"}[1d]))))",

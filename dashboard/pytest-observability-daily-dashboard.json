          "legendFormat": "__auto",
          "expr": "max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_failed_tests{ci_event=\"daily\",run_id=~\"$latest_run_id\"}[90d])))"
        },
        {
          "refId": "Active",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "expr": "max by (test_job, hardware)(last_over_time(pytest_run_job_active{ci_event=\"daily\",run_id=~\"$latest_run_id\"}[5m])) or (((max by (test_job, hardware)(last_over_time(pytest_run_job_failed_tests{ci_event=\"daily\",run_id=~\"$latest_run_id\"}[90d])) >= bool 1) * 3) > 0) or ((max by (test_job, hardware)(last_over_time(pytest_run_job_passed_tests{ci_event=\"daily\",run_id=~\"$latest_run_id\"}[90d])) >= bool 0) * 2)"
        },

      "id": 1,
      "options": {
        "mode": "html",
        "content": "<iframe title=\"test summary\" style=\"width:100%;height:100%;min-height:210px;border:0;background:#181b1f\" srcdoc=\"<style>html,body{margin:0;background:#181b1f;color:#d8d9da;font:14px/1.45 -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif}body{padding:2px 0;background:#181b1f}.node{font-size:15px;font-weight:650;color:#f1f5f9;overflow-wrap:anywhere}.meta{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:8px;color:#aeb7c2}.label{color:#7d8b99}.cmdLabel{margin-top:14px;color:#aeb7c2;font-weight:600}.cmd{display:block;margin-top:6px;padding:10px 12px;border:1px solid #343b45;border-radius:4px;background:#0b0f14;color:#f8fafc;font:13px/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}</style><body><div class='node' id='node'></div><div class='meta'><span><span class='label'>Status</span> <span id='status'></span></span><span><span class='label'>Module</span> <span id='module'></span></span><span><span class='label'>Job</span> <span id='job'></span></span><span><span class='label'>PR</span> <span id='pr'></span></span></div><div class='cmdLabel'>Reproduce locally</div><code class='cmd' id='cmd'></code><script>function setText(id,value){document.getElementById(id).textContent=value||''}var node='${test_nodeid:raw}';var fn='${test_function:raw}';setText('node',node);setText('status','${status_code:raw}');setText('module','${test_module:raw}');setText('job','${test_job:raw}');setText('pr','${pr:raw}');var command=node.indexOf('utils/checkers.py::')===0?'make '+(fn||node.split('::').pop()):'pytest -svx '+node;setText('cmd',command);</script></body>\"></iframe>"
      },
      "pluginVersion": "12.0.0",
      "title": "Summary",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "last_over_time(pytest_test_duration_seconds{test_nodeid=\"$test_nodeid\"}[$__range])",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Duration",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 3,
      "pluginVersion": "12.0.0",
      "repeat": "failure_indicator",
      "repeatDirection": "v",
      "title": "${exception_type:raw}",
      "type": "text",
      "options": {
        "mode": "html",
        "content": "<iframe title=\"traceback\" style=\"width:100%;height:78vh;border:0;border-radius:6px\" srcdoc=\"<style>html,body{margin:0;height:100%;background:#0b0c0e}</style><script>var t=encodeURIComponent('${trace_id}');var n='${test_nodeid}';var u=parent.location.protocol+'//'+parent.location.host+'/failure?trace_id='+t;if(n){u+='&test_nodeid='+encodeURIComponent(n);}location.replace(u);</script>\"></iframe>"
      }
    }
  ],

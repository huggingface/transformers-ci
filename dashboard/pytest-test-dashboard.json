        "content": "<iframe title=\"test\" style=\"width:100%;height:100%;border:0;display:block\" srcdoc=\"<style>html,body{margin:0;height:100%;background:#0b0c0e;color:#9fa3a9;font:13px/1.5 Inter,system-ui,sans-serif}.test-loading{max-width:480px;margin:clamp(28px,12vh,100px) auto;padding:0 20px}.loading-track{position:relative;height:8px;margin:12px 0;border-radius:999px;overflow:hidden;background:#34363c}.loading-sweep{position:absolute;inset:0 auto 0 0;width:40%;background:linear-gradient(90deg,transparent,#8ab8ff,transparent);animation:patch-loading-sweep 1.4s ease-in-out infinite}@keyframes patch-loading-sweep{from{transform:translateX(-100%)}to{transform:translateX(350%)}}@media(prefers-reduced-motion:reduce){.loading-sweep{animation:none;transform:translateX(75%)}}</style><div class=&quot;test-loading&quot; role=&quot;status&quot;>Loading test…<div class=&quot;loading-track&quot;><span class=&quot;loading-sweep&quot; aria-hidden=&quot;true&quot;></span></div></div><script>location.replace(&quot;/test?trace_id=${trace_id:percentencode}&amp;latest_trace=${latest_trace:percentencode}&amp;test_nodeid=${test_nodeid:percentencode}&amp;status=${status_code:percentencode}&amp;job=${test_job:percentencode}&amp;pr=${pr:percentencode}&amp;run_id=${run_id:percentencode}&quot;);</script>\"></iframe>\n\n<iframe title=\"PR search loader\" style=\"display:none\" srcdoc=\"<script>var w=parent;if(w.tciViewed!=='pytest-test'){w.tciViewed='pytest-test';new Image().src='/page-view?d=pytest-test';}if(!w.tciFullNav){w.tciFullNav=1;w.document.addEventListener('click',new w.Function('e',`var a=e.target.closest&&e.target.closest('a');if(!a||e.button||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;if(a.origin!==location.origin||a.pathname.indexOf('/login/')!==0)return;e.preventDefault();e.stopPropagation();location.assign(a.href);`),true);}if(!w.tciDeployGuard){w.tciDeployGuard=1;new w.Function(`var d=document,M='The dashboard is being updated. Reconnecting...';function status(f){try{var w=f.contentWindow,n=w.performance.getEntriesByType('navigation')[0];if(n&&n.responseStatus)return n.responseStatus;var t=(w.document.title||'').slice(0,4);return t==='502 '||t==='503 '||t==='504 '?+t.slice(0,3):0}catch(e){return 0}}function paint(f){try{f.contentDocument.documentElement.innerHTML='<head><style>html,body{margin:0;height:100%;background:transparent;color:#9fa3a9;font:13px/1.5 system-ui,sans-serif}body{display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;box-sizing:border-box}</style></head><body><div>'+M+'</div></body>'}catch(e){}}function check(f){if(!f.isConnected)return;var s=status(f);if(s<502||s>504)return;paint(f);setTimeout(function(){if(!f.isConnected)return;try{f.contentWindow.location.reload()}catch(e){f.src=f.getAttribute('src')}},5000)}function watch(f){if(f.tagName!=='IFRAME'||f.tciGuard||!(f.getAttribute('src')||'').match('^/[^/]')&&!f.hasAttribute('srcdoc'))return;f.tciGuard=1;f.addEventListener('load',function(){check(f)});try{if(f.contentDocument.readyState==='complete')check(f)}catch(e){}}function scan(n){watch(n);if(n.querySelectorAll)n.querySelectorAll('iframe').forEach(watch)}scan(d);new MutationObserver(function(ms){ms.forEach(function(m){if(m.type==='attributes')watch(m.target);else m.addedNodes.forEach(scan)})}).observe(d.body,{childList:true,subtree:true,attributes:true,attributeFilter:['src']});`)();}var d=parent.document;if(!d.getElementById('tci-pr-search')){var f=d.createElement('iframe');f.id='tci-pr-search';f.title='Find a PR';f.src='/pr-search';f.style.cssText='position:fixed;top:4px;left:50%;transform:translateX(-50%);width:0;height:0;border:0;z-index:1060;background:transparent;color-scheme:normal';d.body.appendChild(f);}</script>\"></iframe>\n\n<iframe title=\"exporter link loader\" style=\"display:none\" srcdoc=\"<script>var w=parent;if(!w.tciExporterLinks){w.tciExporterLinks=1;w.document.addEventListener('click',new w.Function('e',`var a=e.target.closest&&e.target.closest('a');if(!a||a.target||e.button||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;if((a.getAttribute('href')||'').indexOf('/failure/')!==0)return;e.preventDefault();e.stopPropagation();location.assign(a.href);`),true);}</script>\"></iframe>"

      "targets": [
        {
          "refId": "Started",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "(max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_member_info{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d])) * on (run_id) group_left() max by (run_id)(max without (instance) (last_over_time(pytest_run_start_time_seconds{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d])))) * 1000) or label_replace(label_replace((min by (test_job) (ci_github_job_started_timestamp_seconds{run_id=~\"$run_id\"} * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 1000), \"hardware\", \"cpu\", \"\", \"\"), \"hardware\", \"gpu\", \"test_job\", \"(?i).*gpu.*\")"
        },
        {
          "refId": "Duration",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_duration_seconds{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d])))"
        },
        {
          "refId": "Pass",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_passed_tests{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d])))"
        },
        {
          "refId": "Fail",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job, hardware) (label_replace(max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_failed_tests{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d]))), \"src\", \"final\", \"\", \"\") or label_replace(sum by (test_job, hardware) (last_over_time(ci_live_calls_total{run_id=~\"$run_id\",hardware=~\"$hardware\",status_code=\"STATUS_CODE_ERROR\"}[1d])), \"src\", \"live\", \"\", \"\"))"
        },
        {
          "refId": "Wall",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_wall_seconds{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d])))"
        },
        {
          "refId": "Status",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "label_replace(label_replace(((max by (test_job) ((ci_github_job_status{run_id=~\"$run_id\"} < 3) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 0 + 1) or (max by (test_job) ((ci_github_job_conclusion_info{conclusion=~\"failure|timed_out|startup_failure\",run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 2) or (max by (test_job) ((ci_github_job_conclusion_info{conclusion=\"success\",run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 4) or (max by (test_job) ((ci_github_job_conclusion_info{conclusion!~\"success|failure|timed_out|startup_failure\",run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 3)), \"hardware\", \"cpu\", \"\", \"\"), \"hardware\", \"gpu\", \"test_job\", \"(?i).*gpu.*\") or (((max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_failed_tests{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d]))) >= bool 1) * 2) > 0) or ((max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_passed_tests{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d]))) >= bool 0) * 4)"
        }

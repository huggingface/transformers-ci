      "targets": [
        {
          "editorMode": "code",
          "expr": "topk($test_limit, max without (instance) (last_over_time(pytest_test_duration_seconds{run_id=~\"$run_id\",status_code=~\"$status_filter\"}[90d])))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Tests (Top $test_limit by Duration)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "run_id": true,
              "service_name": true
            },
            "indexByName": {
              "test_job": 0,
              "test_module": 1,
              "test_class": 2,
              "test_function": 3,
              "trace_id": 4,
              "status_code": 5,
              "Value": 6
            },
            "renameByName": {
              "Value": "Duration",
              "status_code": "Status",
              "test_class": "Class",
              "test_function": "Function",
              "test_module": "Module",
              "test_job": "Job",
              "trace_id": "Trace"
            }
          }
        }
      ],
      "type": "table",
      "description": "Per-test results for the selected run. The query is capped by the Row limit variable so large runs stay responsive."

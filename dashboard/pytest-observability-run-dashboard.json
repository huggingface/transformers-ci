      "targets": [
        {
          "refId": "Started",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job) (max without (instance) (last_over_time(pytest_run_job_member_info{run_id=~\"$run_id\"}[90d])) * on (run_id) group_left() max by (run_id)(max without (instance) (last_over_time(pytest_run_start_time_seconds{run_id=~\"$run_id\"}[90d])))) * 1000"
        },
        {
          "refId": "Duration",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job) (max without (instance) (last_over_time(pytest_run_job_duration_seconds{run_id=~\"$run_id\"}[90d])))"
        },
        {
          "refId": "Pass",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job) (max without (instance) (last_over_time(pytest_run_job_passed_tests{run_id=~\"$run_id\"}[90d])))"
        },
        {
          "refId": "Fail",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (test_job) (max without (instance) (last_over_time(pytest_run_job_failed_tests{run_id=~\"$run_id\"}[90d])))"
        }
      ],
      "title": "Jobs",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "test_job": 0,
              "Value #Started": 1,
              "Value #Duration": 2,
              "Value #Pass": 3,
              "Value #Fail": 4
            },
            "renameByName": {
              "test_job": "Job",
              "Value #Started": "Started",
              "Value #Duration": "Duration",
              "Value #Pass": "Pass",
              "Value #Fail": "Fail"
            }
          }
        }
      ],
      "type": "table"
    }

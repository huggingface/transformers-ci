      "description": "Passed and failed tests of this run; the legend shows each count and share. Counts stream in live before the run's totals are final.",
      "targets": [
        {
          "refId": "PASSED",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(max(label_replace((sum(max without (instance) (last_over_time(pytest_run_job_total_tests{run_id=~\"$run_id\"}[90d]))) or sum(max without (instance) (last_over_time(pytest_run_total_tests{run_id=~\"$run_id\"}[90d])))), \"src\", \"final\", \"\", \"\") or label_replace(sum (last_over_time(ci_live_calls_total{run_id=~\"$run_id\"}[1d])), \"src\", \"live\", \"\", \"\"))) - max(max(label_replace((sum(max without (instance) (last_over_time(pytest_run_job_failed_tests{run_id=~\"$run_id\"}[90d]))) or sum(max without (instance) (last_over_time(pytest_run_failed_tests{run_id=~\"$run_id\"}[90d]))) or vector(0)), \"src\", \"final\", \"\", \"\") or label_replace(sum (last_over_time(ci_live_calls_total{run_id=~\"$run_id\",status_code=\"STATUS_CODE_ERROR\"}[1d])), \"src\", \"live\", \"\", \"\")))",
          "instant": true,
          "range": false,
          "legendFormat": "Passed"
        },
        {
          "refId": "FAILED",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(max(label_replace((sum(max without (instance) (last_over_time(pytest_run_job_failed_tests{run_id=~\"$run_id\"}[90d]))) or sum(max without (instance) (last_over_time(pytest_run_failed_tests{run_id=~\"$run_id\"}[90d]))) or vector(0)), \"src\", \"final\", \"\", \"\") or label_replace(sum (last_over_time(ci_live_calls_total{run_id=~\"$run_id\",status_code=\"STATUS_CODE_ERROR\"}[1d])), \"src\", \"live\", \"\", \"\")))",
          "instant": true,
          "range": false,
          "legendFormat": "Failed"
        }
      ],
      "options": {

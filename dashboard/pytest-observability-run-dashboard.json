{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {"limit": 100, "matchAny": false, "tags": [], "type": "dashboard"},
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "links": [
    {
      "targetBlank": false,
      "title": "Back to Overview",
      "type": "link",
      "url": "/d/pytest-observability/pytest-observability"
    },
    {
      "targetBlank": false,
      "title": "Back to PR",
      "type": "link",
      "url": "/d/pytest-observability-by-pr/pytest-observability-pr?var-pr=${pr}"
    }
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "pytest_run_total_tests{run_id=~\"$run_id\"}",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Total Tests",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "pytest_run_failed_tests{run_id=~\"$run_id\"}",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failed Tests",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 90},
              {"color": "green", "value": 99}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * (1 - pytest_run_failed_tests{run_id=~\"$run_id\"} / pytest_run_total_tests{run_id=~\"$run_id\"})",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Pass Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]},
          "unit": "dateTimeAsLocal"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "pytest_run_start_time_seconds{run_id=~\"$run_id\"} * 1000",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Started",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]},
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"ERROR": {"text": "FAIL", "color": "red", "index": 0}}},
                  {"type": "value", "options": {"OK": {"text": "PASS", "color": "green", "index": 1}}},
                  {"type": "value", "options": {"UNSET": {"text": "PASS", "color": "green", "index": 2}}}
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {"mode": "basic", "type": "color-background"}
              },
              {"id": "unit", "value": "none"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Trace ID"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View traceback",
                    "url": "/d/pytest-traceback?var-trace_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Suite"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View suite details",
                    "url": "/d/pytest-observability-by-suite?var-suite=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 24, "w": 24, "x": 0, "y": 5},
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Duration"}]
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "pytest_test_duration_seconds{run_id=~\"$run_id\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Tests",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "run_id": true,
              "service_name": true,
              "test_nodeid": true
            },
            "indexByName": {
              "test_suite": 0,
              "test_module": 1,
              "test_class": 2,
              "test_function": 3,
              "trace_id": 4,
              "status_code": 5,
              "Value": 6
            },
            "renameByName": {
              "Value": "Duration",
              "status_code": "Status",
              "test_class": "Class",
              "test_function": "Function",
              "test_module": "Module",
              "test_suite": "Suite",
              "trace_id": "Trace ID"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "schemaVersion": 41,
  "tags": ["pytest", "observability", "otel"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "", "value": ""},
        "label": "Run ID",
        "name": "run_id",
        "options": [{"selected": true, "text": "", "value": ""}],
        "query": "",
        "type": "textbox"
      },
      {
        "current": {"selected": false, "text": "", "value": ""},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(pytest_run_total_tests{run_id=~\"$run_id\"}, pr)",
        "hide": 2,
        "includeAll": false,
        "label": "",
        "multi": false,
        "name": "pr",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(pytest_run_total_tests{run_id=~\"$run_id\"}, pr)",
          "refId": "Prometheus-pr-Variable-Query"
        },
        "refresh": 1,
        "skipUrlSync": true,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Pytest Observability - Run",
  "uid": "pytest-observability-by-run",
  "version": 1
}

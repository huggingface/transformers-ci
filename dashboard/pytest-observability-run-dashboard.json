          "expr": "label_replace(label_replace(((max by (test_job) ((ci_github_job_status{run_id=~\"$run_id\"} < 3) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 0 + 1) or (max by (test_job) ((ci_github_job_conclusion_info{conclusion=~\"failure|timed_out|startup_failure\",run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 3) or (max by (test_job) ((ci_github_job_conclusion_info{conclusion=\"success\",run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 2) or (max by (test_job) ((ci_github_job_conclusion_info{conclusion!~\"success|failure|timed_out|startup_failure\",run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 4)), \"hardware\", \"cpu\", \"\", \"\"), \"hardware\", \"gpu\", \"test_job\", \"(?i).*gpu.*\") or (((max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_failed_tests{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d]))) >= bool 1) * 3) > 0) or ((max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_passed_tests{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d]))) >= bool 0) * 2)"

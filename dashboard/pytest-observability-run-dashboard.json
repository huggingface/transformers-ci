          "expr": "(max by (test_job, hardware) (max without (instance) (last_over_time(pytest_run_job_member_info{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d])) * on (run_id) group_left() max by (run_id)(max without (instance) (last_over_time(pytest_run_start_time_seconds{run_id=~\"$run_id\",hardware=~\"$hardware\"}[90d])))) * 1000) or label_replace(label_replace((min by (test_job) (ci_github_job_started_timestamp_seconds{run_id=~\"$run_id\"} * on (repository, run_id, job_id) group_left(test_job) ci_github_job_info{run_id=~\"$run_id\"}) * 1000), \"hardware\", \"cpu\", \"\", \"\"), \"hardware\", \"gpu\", \"test_job\", \"(?i).*gpu.*\")"

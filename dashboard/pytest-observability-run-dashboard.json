        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #Status": 0,
              "test_job": 1,
              "Value #Pass": 2,
              "Value #Fail": 3,
              "hardware": 4,
              "Value #Started": 5,
              "Value #Duration": 6,
              "Value #Wall": 7
            },
            "renameByName": {
              "test_job": "Job",
              "Value #Started": "Started",
              "Value #Duration": "Test Time",
              "Value #Pass": "Pass",
              "Value #Fail": "Fail",
              "Value #Wall": "Wall",
              "hardware": "Hardware",
              "Value #Status": "Status"
            }
          }
        }
      ],
      "type": "table",
      "description": "Status from GitHub while the run is recent (jobs appear before any telemetry; grey = cancelled or skipped); test counts from traces, with failures streamed from the collector while the run is in flight."
    }

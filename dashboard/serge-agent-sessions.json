    {
      "id": 5,
      "type": "stat",
      "title": "Budget spent re-opening files",
      "description": "Share of all tool calls that re-opened a path the session had already opened. Each one costs a full turn \u2014 the whole conversation is resent, not just the file \u2014 so this is the cheapest waste to remove.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,

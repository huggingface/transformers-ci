    {
      "id": 20,
      "type": "table",
      "title": "Sessions",
      "description": "One row per finished serge job. `Stopped by` is the column to read first: `answered` is the only value meaning the model decided it was done \u2014 every other value is a guard cutting the session off and forcing an answer out of whatever budget was left.\n\n`Path re-opens` counts tool calls that opened a file the session had already opened (per path, visits-1). It is not the same as `Verbatim repeats`, which the tool-repeat guard counts: re-reading a different line range of the same file is a re-open but not a verbatim repeat, and it is the re-opens that dominate.\n\nA repo not on the scrape's public allow-list reads as `other` \u2014 the counters are complete, only the name is withheld.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Finished"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Stopped by"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "answered": {
                        "text": "answered",
                        "color": "green",
                        "index": 0
                      },
                      "input_token_cap": {
                        "text": "input token cap",
                        "color": "red",
                        "index": 1
                      },
                      "repeat_guard": {
                        "text": "repeat guard",
                        "color": "orange",
                        "index": 2
                      },
                      "blind_turn_cap": {
                        "text": "blind-turn cap",
                        "color": "orange",
                        "index": 4
                      },
                      "strict_tool_cap": {
                        "text": "tool-call cap",
                        "color": "orange",
                        "index": 5
                      },
                      "absolute_ceiling": {
                        "text": "iteration ceiling",
                        "color": "red",
                        "index": 6
                      },
                      "chunk_input_token_cap": {
                        "text": "chunks skipped (budget)",
                        "color": "red",
                        "index": 7
                      },
                      "no_llm_turns": {
                        "text": "never ran",
                        "color": "text",
                        "index": 8
                      },
                      "path_revisit_guard": {
                        "text": "path re-visit guard",
                        "color": "orange",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "published": {
                        "text": "published",
                        "color": "green",
                        "index": 0
                      },
                      "no_fix": {
                        "text": "no fix",
                        "color": "yellow",
                        "index": 1
                      },
                      "error": {
                        "text": "error",
                        "color": "red",
                        "index": 2
                      },
                      "done": {
                        "text": "done",
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Input tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LLM time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PR"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the pull request",
                    "targetBlank": true,
                    "url": "https://github.com/${__data.fields.Repo}/pull/${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Finished"
          }
        ]
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "refId": "Finished",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_finished_timestamp_seconds[$__range]) * on (job_id) group_left(repo, pr, status, stop_reason, verify_verdict, kind, model) max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range]))) * 1000"
        },
        {
          "refId": "Rounds",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_rounds[$__range]) * on (job_id) group_left(repo, pr, status, stop_reason, verify_verdict, kind, model) max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range])))"
        },
        {
          "refId": "Turns",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_turns[$__range]) * on (job_id) group_left(repo, pr, status, stop_reason, verify_verdict, kind, model) max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range])))"
        },
        {
          "refId": "Tools",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_tool_calls[$__range]) * on (job_id) group_left(repo, pr, status, stop_reason, verify_verdict, kind, model) max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range])))"
        },
        {
          "refId": "Revisits",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_path_revisits[$__range]) * on (job_id) group_left(repo, pr, status, stop_reason, verify_verdict, kind, model) max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range])))"
        },
        {
          "refId": "Paths",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_distinct_paths[$__range]) * on (job_id) group_left(repo, pr, status, stop_reason, verify_verdict, kind, model) max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range])))"
        },
        {
          "refId": "Repeats",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_repeat_calls[$__range]) * on (job_id) group_left(repo, pr, status, stop_reason, verify_verdict, kind, model) max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range])))"
        },
        {
          "refId": "InTokens",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,

  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### serge agent sessions\nHow serge's LLM loop actually spends a job. serge's own store keeps only its last **25 jobs** (~2 days) \u2014 these series are the durable copy, so ask for a wide time range. A gap means jobs aged out of serge before a scrape saw them, not that serge was idle."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sessions",
      "description": "Finished serge jobs in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(count by (job_id) (max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range]))))",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Finished on their own terms",
      "description": "Share of sessions that ended because the model returned an answer while it still had tools and budget, rather than because a guard cut it off. A low number means the patches being published are written by starved final turns.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 4,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (count(count by (job_id) (max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info{stop_reason=\"answered\"}[$__range])))) or vector(0)) / (count(count by (job_id) (max by (job_id, repo, pr, status, stop_reason, verify_verdict, kind, model) (last_over_time(serge_job_info[$__range])))) > 0)",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ]
    },

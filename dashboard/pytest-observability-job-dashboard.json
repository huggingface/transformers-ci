      "description": "Whether this workflow run is still queued or in progress, straight from the GitHub Actions API. While it says Running, the counters on this page are a partial snapshot of the run so far \u2014 the exporter publishes the roll-up once and Prometheus keeps showing that value, so a run can read 100% green long before its failures land.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "image"
            },
            "inspect": false
          },
          "mappings": [

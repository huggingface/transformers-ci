  "panels": [
    {
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 20,
      "options": {
        "content": "### `${job}`\n\n**Run:** `${run_id}`\n\n**PR:** `${pr}`",
        "mode": "markdown"
      },
      "pluginVersion": "12.0.0",
      "title": "Job",
      "type": "text"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue"}]}
        }
      },
      "gridPos": {"h": 5, "w": 3, "x": 6, "y": 0},
      "id": 21,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(pytest_test_duration_seconds{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",run_id=~\"$run_id\"})",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Tests",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}
        }
      },
      "gridPos": {"h": 5, "w": 3, "x": 9, "y": 0},
      "id": 22,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(pytest_test_duration_seconds{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",run_id=~\"$run_id\",status_code=\"OK\"}) or vector(0)",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Passed",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"h": 5, "w": 3, "x": 12, "y": 0},
      "id": 23,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(pytest_test_duration_seconds{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",run_id=~\"$run_id\",status_code=\"ERROR\"}) or vector(0)",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failed",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue"}]},
          "unit": "s"
        }
      },
      "gridPos": {"h": 5, "w": 3, "x": 15, "y": 0},
      "id": 24,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(pytest_test_duration_seconds{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",run_id=~\"$run_id\"})",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Duration",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue"}]},
          "unit": "dateTimeFromNow"
        }
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 25,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(pytest_run_start_time_seconds{service_name=~\"$service\",pr=~\"$pr\",run_id=~\"$run_id\"}) * 1000",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Started",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-test results for the run currently selected via the Run ID template variable. Defaults to all runs (.*).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]},
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"ERROR": {"text": "FAIL", "color": "red", "index": 0}}},
                  {"type": "value", "options": {"OK": {"text": "PASS", "color": "green", "index": 1}}},
                  {"type": "value", "options": {"UNSET": {"text": "PASS", "color": "green", "index": 2}}}
                ]
              },
              {"id": "custom.cellOptions", "value": {"mode": "basic", "type": "color-background"}},
              {"id": "unit", "value": "none"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Trace"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View traceback",
                    "url": "/d/pytest-traceback?var-trace_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 22, "w": 24, "x": 0, "y": 5},
      "id": 14,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Duration"}]
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "pytest_test_duration_seconds{service_name=~\"$service\",test_job=~\"$job\",pr=~\"$pr\",run_id=~\"$run_id\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Tests for Selected Run",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "service_name": true,
              "test_job": true,
              "test_nodeid": true
            },
            "indexByName": {
              "test_module": 0,
              "test_class": 1,
              "test_function": 2,
              "status_code": 3,
              "trace_id": 4,
              "Value": 5
            },
            "renameByName": {
              "Value": "Duration",
              "status_code": "Status",
              "test_class": "Class",
              "test_function": "Function",
              "test_module": "Module",
              "trace_id": "Trace"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "schemaVersion": 41,
  "tags": ["pytest", "observability", "otel"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(pytest_test_average_duration_seconds, service_name)",
        "includeAll": true,
        "label": "Service",
        "multi": false,
        "name": "service",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(pytest_test_average_duration_seconds, service_name)",
          "refId": "Prometheus-service-Variable-Query"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {"selected": false, "text": "", "value": ""},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(pytest_test_average_duration_seconds{service_name=~\"$service\"}, test_job)",
        "includeAll": false,
        "label": "Job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(pytest_test_average_duration_seconds{service_name=~\"$service\"}, test_job)",
          "refId": "Prometheus-job-Variable-Query"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(pytest_test_average_duration_seconds{service_name=~\"$service\",test_job=~\"$job\"}, pr)",
        "includeAll": true,
        "label": "PR",
        "multi": false,
        "name": "pr",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(pytest_test_average_duration_seconds{service_name=~\"$service\",test_job=~\"$job\"}, pr)",
          "refId": "Prometheus-pr-Variable-Query"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {"selected": false, "text": ".*", "value": ".*"},
        "label": "Run ID",
        "name": "run_id",
        "options": [{"selected": true, "text": ".*", "value": ".*"}],
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Pytest Observability - Job",
  "uid": "pytest-observability-by-job",

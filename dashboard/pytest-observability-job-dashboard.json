          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Tests for Selected Run (Top $test_limit by Duration)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pr": true,
              "provider": true,
              "service_name": true,
              "test_job": true
            },
            "indexByName": {
              "test_module": 0,
              "test_class": 1,
              "test_function": 2,
              "status_code": 3,
              "trace_id": 4,
              "Value": 5
            },
            "renameByName": {
              "Value": "Duration",
              "status_code": "Status",
              "test_class": "Class",
              "test_function": "Function",
              "test_module": "Module",
              "trace_id": "Trace"
            }
          }
        }
      ],
      "type": "table"
    }

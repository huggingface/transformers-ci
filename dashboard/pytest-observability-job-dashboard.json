    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether this job's shards are still queued/running, from GitHub while the run is recent. 'Watch live' opens the auto-refreshing view of the run.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "image"
            },
            "inspect": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "data:image/svg+xml;base64,",
                  "index": 0
                },
                "0": {
                  "text": "data:image/svg+xml;base64,",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "id": 28,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": false
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(max((ci_github_job_status{run_id=~\"$run_id\"} and on (repository, run_id, job_id) ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}) < 3) * 0 + 1) or (max((ci_github_job_status{run_id=~\"$run_id\"} and on (repository, run_id, job_id) ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}) == 3) * 0) or (max (last_over_time(pytest_run_active{run_id=~\"$run_id\"}[5m])) or vector(0))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Active"
        }
      ],
      "title": "Live",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Live"
            }
          }
        }
      ],
      "type": "table",
      "links": [
        {
          "title": "Watch live (auto-refresh)",
          "url": "/d/ci-live-status/live-ci-status?orgId=1&var-run=${run_id}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 29,
      "type": "table",
      "title": "GitHub shards of this job",
      "description": "Each GitHub job running this test job in this run, from GitHub (ci-github-status). Kept for 6h after the run; older runs show nothing here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "Status",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, gh_run, name, conclusion) ((ci_github_job_status{run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(name, conclusion, gh_run) ((label_replace(ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}, \"gh_run\", \"$1\", \"run_id\", \"([0-9]+):.*\") * on (repository, run_id, job_id) group_left(conclusion) ci_github_job_conclusion_info{run_id=~\"$run_id\"}) or on (repository, run_id, job_id) label_replace(label_replace(ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}, \"gh_run\", \"$1\", \"run_id\", \"([0-9]+):.*\"), \"conclusion\", \"\u2014\", \"\", \"\")))"
        },
        {
          "refId": "Started",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, gh_run, name, conclusion) ((ci_github_job_started_timestamp_seconds{run_id=~\"$run_id\"} * 1000) * on (repository, run_id, job_id) group_left(name, conclusion, gh_run) ((label_replace(ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}, \"gh_run\", \"$1\", \"run_id\", \"([0-9]+):.*\") * on (repository, run_id, job_id) group_left(conclusion) ci_github_job_conclusion_info{run_id=~\"$run_id\"}) or on (repository, run_id, job_id) label_replace(label_replace(ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}, \"gh_run\", \"$1\", \"run_id\", \"([0-9]+):.*\"), \"conclusion\", \"\u2014\", \"\", \"\")))"
        },
        {
          "refId": "Duration",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "max by (job_id, gh_run, name, conclusion) (((ci_github_job_completed_timestamp_seconds{run_id=~\"$run_id\"} or on (repository, run_id, job_id) (ci_github_job_started_timestamp_seconds{run_id=~\"$run_id\"} * 0 + time())) - ci_github_job_started_timestamp_seconds{run_id=~\"$run_id\"}) * on (repository, run_id, job_id) group_left(name, conclusion, gh_run) ((label_replace(ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}, \"gh_run\", \"$1\", \"run_id\", \"([0-9]+):.*\") * on (repository, run_id, job_id) group_left(conclusion) ci_github_job_conclusion_info{run_id=~\"$run_id\"}) or on (repository, run_id, job_id) label_replace(label_replace(ci_github_job_info{run_id=~\"$run_id\",test_job=~\"$job\"}, \"gh_run\", \"$1\", \"run_id\", \"([0-9]+):.*\"), \"conclusion\", \"\u2014\", \"\", \"\")))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Shard",
              "conclusion": "Conclusion",
              "Value #Status": "Status",
              "Value #Started": "Started",
              "Value #Duration": "Duration"
            },
            "indexByName": {
              "name": 0,
              "Value #Status": 1,
              "conclusion": 2,
              "Value #Started": 3,
              "Value #Duration": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Queued",
                        "color": "yellow",
                        "index": 0
                      },
                      "2": {
                        "text": "Running",
                        "color": "blue",
                        "index": 1
                      },
                      "3": {
                        "text": "Completed",
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Conclusion"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "failure": {
                        "color": "red",
                        "index": 1
                      },
                      "timed_out": {
                        "color": "red",
                        "index": 2
                      },
                      "cancelled": {
                        "color": "orange",
                        "index": 3
                      },
                      "skipped": {
                        "color": "text",
                        "index": 4
                      },
                      "\u2014": {
                        "text": "",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Shard"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "url": "https://github.com/huggingface/transformers/actions/runs/${__data.fields.gh_run}/job/${__data.fields.job_id}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gh_run"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      }
    }
  ],
